{
  "name": "compact-jev",
  "version": "0.5.2",
  "description": "Verbatim context compaction for LLM agents using Jev through Vercel AI Gateway.",
  "repository": { "type": "git", "url": "https://github.com/edoproch/compact-jev.git" },
  "homepage": "https://github.com/edoproch/compact-jev#readme",
  "bugs": "https://github.com/edoproch/compact-jev/issues",
  "keywords": ["claude-code", "context-compaction", "jev", "vercel-ai-gateway"],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks",
    "test": "vitest run",
    "benchmark": "tsx benchmarks/run.ts",
    "demo": "tsx examples/demo.ts",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
